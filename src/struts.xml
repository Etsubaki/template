<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.3//EN"
"http://struts.apache.org/dtds/struts-2.3.dtd">

<struts>
	<constant name="struts.devMode" value="true" />
	<package name="com.diworksdev.templete.action" extends="struts-default">

		<action name="HomeAction" class="comdiworksdev.templete.action.HomeAction" method="execute">
			<result name="success">login.jsp</result>
		</action>

		<action name="LoginAction" class="comdiworksdev.templete.action.LoginAction" method="execute">
			<result name="success">buyItem.jsp</result>
			<result name="error">home.jsp</result>
		</action>

		<action name="UserCreateAction" class="comdiworksdev.templete.action.UserCreateAction" method="execute">
			<result name="success">userCreate.jsp</result>
		</action>

		<action name="UserCreateConfirmAction" class="comdiworksdev.templete.action.UserCreteConfirmAction" method="execute">
			<result name="success">userCreateConfirm.jsp</result>
			<result name="error">userCreate.jsp</result>
		</action>

		<action name="UserCreateCompleteAction" class="comdiworksdev.templete.action.UserCreateAction" method="execute">
			<result name="success">userCreateComplete.jsp</result>
		</action>

		<action name="BuyItemAction" class="comdiworksdev.templete.action.BuyItemAction" method="execute">
			<result name="success">buyItemConfirm.jsp</result>
		</action>

		<action name="BuyItemComfirmAction" class="comdiworksdev.templete.action.BuyItemConfirmAction" method="execute">
			<result name="success">buyItemComplete.jsp</result>
		</action>

		<action name="MyPageAction" class="comdiworksdev.templete.action.MyPageAction" method="execute">
			<result name="success">myPage.jsp</result>
		</action>
	</package>
</struts>